<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".NouaActivitate">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <EditText
            android:id="@+id/etNume"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Nume cutie bomboane"
            android:inputType="text" />

        <EditText
            android:id="@+id/etMarca"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Marca"
            android:inputType="text" />

        <EditText
            android:id="@+id/etGramaj"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Gramaj (ex: 250)"
            android:inputType="numberDecimal" />

        <EditText
            android:id="@+id/etNumarBomboane"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Număr bomboane"
            android:inputType="number" />

        <EditText
            android:id="@+id/etDataExpirare"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Data expirare (ZZ.LL.AAAA)"
            android:inputType="date" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Tip diversitate bomboane:" />

        <Spinner
            android:id="@+id/spinnerTip"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"/>

        <CheckBox
            android:id="@+id/cbDiscount"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Se aplică discount?" />

        <Button
            android:id="@+id/btnSalvare"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Salvează Cutia"
            android:onClick="adaugareCutie"/>

    </LinearLayout>

</ScrollView>